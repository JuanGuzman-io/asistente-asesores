# Copiar a .env. Sin clave el servicio funciona en modo extractivo, sin costo.
GEMINI_API_KEY=
# Tope de llamadas simultáneas a Gemini (entero positivo; por defecto 5). Un valor inválido
# detiene el arranque. Los límites reales dependen del proyecto: https://aistudio.google.com/rate-limit
GEMINI_MAX_CONCURRENCIA=5
